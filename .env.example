# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required for Stage 0 auth + database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: server-only admin operations in later stages
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GitHub OAuth is configured in the Supabase dashboard:
# Authentication → Providers → GitHub
# Callback URL (Supabase): https://your-project.supabase.co/auth/v1/callback
# Also add this app callback in GitHub OAuth app if using custom provider settings:
# http://localhost:3000/auth/callback

# GitHub App (Stage 1 — optional in Stage 0)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
