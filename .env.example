# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required for auth + database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for Stage 1 webhook ingestion (server-only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# GitHub OAuth (user sign-in) is configured in Supabase Dashboard:
# Authentication → Providers → GitHub
# Callback URL: https://your-project.supabase.co/auth/v1/callback
# ---------------------------------------------------------------------------

# GitHub App (Stage 1 — repository access + webhooks)
# Create at: https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Optional App OAuth credentials (only if using App user-to-server OAuth)
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# RECOMMENDED: path to the downloaded .pem private key (easiest, no \n escaping)
# Place the file outside git, e.g. secrets/github-app.pem (add secrets/ to .gitignore)
GITHUB_APP_PRIVATE_KEY_PATH=secrets/github-app.pem
# OR paste the full key (must stay on ONE logical env value; multi-line without
# proper quoting breaks dotenv). Prefer the path option above.
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_APP_PRIVATE_KEY=
# Webhook secret (generate a long random string; same value in GitHub App settings)
GITHUB_APP_WEBHOOK_SECRET=

# GitHub App URLs (configure in the GitHub App settings UI):
# Homepage URL:     {NEXT_PUBLIC_APP_URL}
# Setup URL:        {NEXT_PUBLIC_APP_URL}/api/github/setup
# Webhook URL:      {NEXT_PUBLIC_APP_URL}/api/github/webhooks
# Callback URL:     {NEXT_PUBLIC_APP_URL}/api/github/setup  (optional)
#
# Minimum permissions (Repository):
#   Metadata: Read-only
#   Contents: Read-only
#   Pull requests: Read-only
#
# Subscribe to events:
#   Installation
#   Installation repositories
#   Pull request

# ---------------------------------------------------------------------------
# Stage 2 — AI analysis (server-only; never expose to the client)
# Default provider: OpenRouter free model (no paid credits required)
# Keys: https://openrouter.ai/keys
# Docs: https://openrouter.ai/docs
# ---------------------------------------------------------------------------
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Exact free model (do not switch to paid models for $0 budget)
OPENROUTER_MODEL=cohere/north-mini-code:free

# Optional alternate free provider (set AI_PROVIDER=gemini)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
